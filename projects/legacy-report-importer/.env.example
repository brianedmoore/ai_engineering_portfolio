# Copy to .env and fill in values

# Required — OpenAI API key
OPENAI_API_KEY=your_key_here

# Optional — override the default LLM model
# IMPORTER_LLM_MODEL=gpt-4o-mini

# Optional — skip human review prompt (useful for batch imports)
# AUTO_APPROVE=true

# Optional — LangSmith tracing (free tier at smith.langchain.com)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key
# LANGCHAIN_PROJECT=legacy-report-importer
